# ============================================================
# chat —— 聊天专用
# ------------------------------------------------------------
# 面向"打开就聊"的场景：记忆、富文本渲染、生图、通知这类插件，
# 不装编码 / 运维类插件。
# 插件清单待选: 现在留空, 选好后写进同目录 plugins.txt 即可, 不用重建镜像。
# 环境用 base 就够（slim 镜像），不需要 Python / LibreOffice。
# ============================================================
PLAN_TITLE="聊天专用"
PLAN_DESC="对话、记忆、生图、通知；插件清单待选"
PLAN_ENV=base
PLAN_PROFILE=web
PLAN_ENTRY=web
