# ============================================================
# dev —— 开发实例（空白 dsh）
# ------------------------------------------------------------
# 只给 docker-compose.dev.yml 用: 空 profile + 空清单, 由
# bootstrap-dev/20-link-plugins.sh 把挂进来的插件源码逐个 link: 安装。
#
# 默认 base 档(slim 镜像): 开发迭代要快, 而绝大多数插件不需要 LibreOffice/
# Python/CJK 字体这些重量级系统依赖。真需要时(office/PDF/视频合成)再把这里
# 改成 capable, 并在下面写清是哪个插件要的 —— 那意味着"环境变了", 走的是
# 重建镜像那条路, 不是改清单。
# 不要用普通 compose 起它: 那会落到生产栈上; 用 ./scripts/up.sh dev。
# ============================================================
PLAN_TITLE="开发实例（空白）"
PLAN_DESC="空白 dsh + 源码挂载，供插件开发"
PLAN_ENV=base
PLAN_PROFILE=web
PLAN_ENTRY=web
