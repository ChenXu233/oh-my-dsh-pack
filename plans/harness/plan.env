# ============================================================
# harness —— 把订阅版的能力搬到自己机器上
# ------------------------------------------------------------
# 目标：像 Kimi / 豆包订阅那样"能出东西"——PPT、文档、表格、图片、
# 联网深度研究、定时任务、长期记忆——但模型、额度、部署位置全是自己的。
# 单人使用，没有账号体系，不涉及计费。
#
# 需要 capable 镜像：office 系列技能靠 python-docx/pptx/openpyxl 和
# LibreOffice 渲染，中文还要 CJK 字体。只装插件是不够的。
#
# 预留：视频生成（插件侧已有生态，镜像里 ffmpeg 默认不装，
#       用 --build-arg INSTALL_FFMPEG=1 打开）。
# ============================================================
PLAN_TITLE="能力全量（自建订阅版体验）"
PLAN_DESC="文档/表格/PPT/图片/联网研究/定时任务/记忆，单人自控"
PLAN_TIER=capable
PLAN_PROFILE=web
PLAN_ENTRY=web
