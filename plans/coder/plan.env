# ============================================================
# coder —— 无头编程器
# ------------------------------------------------------------
# 没有网页 UI，跑一次任务把结果打到 stdout 就退出：
#   docker compose run --rm dsh "把测试修好"
# 走 dsh 的 headless profile，用 slim 镜像即可。
# ============================================================
PLAN_TITLE="无头编程器"
PLAN_DESC="一次性任务，结果走 stdout，无常驻服务"
PLAN_TIER=slim
PLAN_PROFILE=headless
PLAN_ENTRY=headless
