# ============================================================
# ci —— 一次性 headless（镜像内自带预置 profile，启动零安装）
# ------------------------------------------------------------
# 和 web 方向最大的区别：profile 在 Dockerfile 的 ci 阶段就装好并烤进
# :ci 镜像，容器启动时 plan-boot 只做 dump-config 校验和 exec，
# 不再跑 dsh plugin add。CI 拉镜像就能用，不会每次冷装插件。
#
# 预置内容见 Dockerfile 的 ci 阶段：
#   - profile headless
#   - @chenxu233/dsh-agent-teams（唯一实测会给 headless 加工具的包）
#
# 注意：headless 的两条实测坑（CI 必读 docs/PLANS.md）：
#   1. 容器里 workspace-write 沙箱不可用且失败静默 -> danger-full-access
#   2. slash 命令在 headless 不执行 -> 靠 slash 暴露能力的插件没用
# ============================================================
PLAN_TITLE="CI 一次性（预置 profile）"
PLAN_DESC="headless + headless profile 烤进镜像；零冷装、无 TTY"
PLAN_ENV=base
PLAN_PROFILE=headless
PLAN_ENTRY=headless

# dsh 的调用参数（每次启动都会追加到 exec dsh ... 后面）
# 例：PLAN_ARGS="--json -a <AGENT_ID> -w <WORKFLOW_ID>"
PLAN_ARGS="--json"

# 容器内 headless 没有交互确认；容器本身即边界。
# 等价于 danger-full-access + never，避免 workspace-write 静默失败。
export DSH_PERMISSION_MODE=danger-full-access
export DSH_APPROVAL_POLICY=never
