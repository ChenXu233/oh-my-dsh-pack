# 已部署到 /etc/caddy/Caddyfile (备份: Caddyfile.bak-lobe)
harness.chenxu233.cn {
	encode zstd gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}

	# 抹平客户端双斜杠 bug
	@doubleslash path_regexp doubleslash ^//+(.*)$
	rewrite @doubleslash /{re.doubleslash.1}

	# DSH 内置鉴权(启动token+签名cookie); 本站只做 TLS 反代, 保留 Host, WebSocket 透传
	# 可选双保险: basic_auth (caddy hash-password 生成后取消注释)
	# basic_auth {
	# 	chenxu $2a$14$REPLACE_WITH_YOUR_HASH
	# }

	reverse_proxy 127.0.0.1:3210
}
